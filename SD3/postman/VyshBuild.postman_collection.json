{
  "info": {
    "name": "ВышBuild",
    "description": "Все ключевые API через API Gateway. Запуск по порядку: Runner или `newman run postman/VyshBuild.postman_collection.json --working-dir .` из папки SD3.\nПервый запрос создаёт новое задание `dz-3-<время>`, поэтому коллекцию можно гонять повторно на тех же данных.\nВ Postman укажите рабочую папку SD3 (Settings → Working directory), чтобы нашлись файлы из samples/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "assignmentId",
      "value": "dz-3"
    },
    {
      "key": "goodId",
      "value": ""
    },
    {
      "key": "emptyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Студент: сдача работы",
      "item": [
        {
          "name": "Сдать рабочий Python-проект",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions"
              ]
            },
            "description": "Сценарий сдачи: Gateway → Store → Analyze. Файл `samples/good-python.zip`.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "student",
                  "value": "Иванов Иван",
                  "type": "text"
                },
                {
                  "key": "assignment_id",
                  "value": "{{assignmentId}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/good-python.zip"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Своё задание на каждый прогон: повторный запуск не смешивается с прошлыми сдачами.",
                  "pm.collectionVariables.set('assignmentId', 'dz-3-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('report SUCCESS', () => pm.expect(body.report.status).to.eql('SUCCESS'));",
                  "pm.collectionVariables.set('goodId', body.submission.submission_id);"
                ]
              }
            }
          ]
        },
