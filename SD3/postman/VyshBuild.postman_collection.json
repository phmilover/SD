    {
      "name": "Преподаватель: аналитика",
      "item": [
        {
          "name": "Сводка по заданию (JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assignments/{{assignmentId}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assignments",
                "{{assignmentId}}",
                "reports"
              ]
            },
            "description": "5 студентов, у Петрова две попытки: в счётчиках учитывается последняя."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('5 студентов', () => pm.expect(s.students).to.eql(5));",
                  "pm.test('считается последняя попытка Петрова', () => {",
                  "  const petrov = s.submissions.filter(r => r.submission.student === 'Петров Пётр');",
                  "  pm.expect(petrov.map(r => r.is_latest)).to.eql([false, true]);",
                  "});"
                ]
              }
            }
          ]
        },
